# Server Config
APP_NAME="RAG Backend API"
DEBUG=True
PORT=8000
HOST="0.0.0.0"

# Database Configuration (SQLite default for zero-config, PostgreSQL compatible)
DATABASE_URL="sqlite:///./rag_app.db"

# Redis Configuration (Leave blank or empty to use built-in fast in-memory Redis fallback)
REDIS_URL="redis://localhost:6379/0"

# Vector Store Configuration
VECTOR_DB_TYPE="qdrant" # Options: qdrant, pinecone
QDRANT_LOCATION=":memory:" # Use ":memory:" for zero-config, or "http://localhost:6333" for local container
QDRANT_API_KEY=""
QDRANT_COLLECTION_NAME="documents"

# Pinecone Configuration (Optional if VECTOR_DB_TYPE="pinecone")
PINECONE_API_KEY=""
PINECONE_INDEX_NAME=""

# OpenAI Configuration (For LLM RAG & Embeddings)
OPENAI_API_KEY="sk-fake-key-for-mocking"
OPENAI_MODEL="gpt-4o-mini"
EMBEDDING_MODEL="text-embedding-3-small"
USE_MOCK_LLM=True # Set to False when real OPENAI_API_KEY is provided
